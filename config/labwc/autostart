#!/bin/sh
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY GDK_BACKEND XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
/usr/bin/husk-desktop-start &
if [ ! -d /run/archiso ] && [ -x /usr/bin/swayidle ]; then
    swayidle -w timeout 600 '/usr/bin/husk-lock' before-sleep '/usr/bin/husk-lock' &
fi
