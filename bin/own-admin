#!/usr/bin/python3 -I
"""Installed at a fixed, root-owned path; authorized by a specific polkit action."""
import fcntl
import os
import subprocess
import sys
from pathlib import Path
sys.path.insert(0, '/usr/lib/ownos')
from ownos.updates import admin_command
from ownos.i18n import _


def main():
    if os.geteuid() != 0: raise PermissionError(_('Run through pkexec'))
    if not 2 <= len(sys.argv) <= 3: raise ValueError(_('Invalid arguments'))
    command = admin_command(sys.argv[1], sys.argv[2] if len(sys.argv) == 3 else None)
    if Path('/var/lib/pacman/db.lck').exists():
        raise RuntimeError(_('Another pacman transaction is active. The lock will not be removed automatically.'))
    directory = Path('/var/lib/ownos'); directory.mkdir(mode=0o755, exist_ok=True)
    with (directory / 'admin.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        print(_('Husk OS: verified full-system transaction: {command}').format(command=' '.join(command)), flush=True)
        return subprocess.call(command, env={'PATH': '/usr/bin:/bin', 'LANG': 'C.UTF-8'})


if __name__ == '__main__':
    try: raise SystemExit(main())
    except (OSError, ValueError, RuntimeError) as exc:
        print('Husk OS:', exc, file=sys.stderr); raise SystemExit(1)
