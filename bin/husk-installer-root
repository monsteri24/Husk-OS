#!/bin/sh
set -eu
[ "$(id -u)" = 0 ] || exit 1
[ -d /run/archiso ] && [ -d /sys/firmware/efi ] || exit 1
[ -f /run/archiso/bootmnt/arch/x86_64/airootfs.sfs ] || exit 1
export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
export QT_QPA_PLATFORM=xcb QT_STYLE_OVERRIDE=Fusion QT_QUICK_CONTROLS_STYLE=Basic
exec /usr/bin/calamares -c /etc/calamares -style fusion -stylesheet /etc/calamares/husk.qss
