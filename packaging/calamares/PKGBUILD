# Reviewed upstream release; this project does not execute an AUR recipe.
pkgname=calamares
pkgver=3.3.14
pkgrel=2
pkgdesc='Distribution-independent installer with Python jobs (Husk OS build)'
arch=('x86_64')
url='https://calamares.io/'
license=('GPL-3.0-or-later' 'BSD-2-Clause' 'LGPL-2.1-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'kpmcore' 'yaml-cpp'
         'python' 'icu' 'libpwquality' 'polkit' 'kconfig' 'kcoreaddons' 'ki18n'
         'kservice' 'kiconthemes' 'solid' 'kjobwidgets')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'git' 'pkgconf' 'pybind11')
source=("https://github.com/calamares/calamares/releases/download/v${pkgver}/calamares-${pkgver}.tar.gz"
        'HuskDiskGuard.h' 'HuskClockSelector.h' 'husk-finished.qml'
        'patch-calamares-safety.py' 'patch-calamares-ui.py')
sha256sums=('5547f80db067dea923ae693ba6bb88eb2b2eeac1da3ebec42fce453e31c290c0' __HUSK_SOURCE_SHA256S__)

prepare() {
  python patch-calamares-safety.py "calamares-$pkgver" --assets "$srcdir"
  python patch-calamares-ui.py "calamares-$pkgver" --assets "$srcdir"
}

build() {
  cmake -S "calamares-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
    -DWITH_QT6=ON -DWITH_QML=ON -DWITH_PYTHON=ON -DWITH_PYBIND11=ON -DBUILD_TESTING=OFF -DINSTALL_CONFIG=OFF \
    -DDEBUG_PARTITION_UNSAFE=OFF -DDEBUG_PARTITION_SKIP=OFF \
    -DSKIP_MODULES='contextualprocess;dummy;dummypython;dummypythonqt;interactiveterminal;licenseq;localeq;notesqml;oemid;packagechooserq;plasmalnf;preservefiles;tracking;webview'
  cmake --build build --parallel 2
}
package() {
  DESTDIR="$pkgdir" cmake --install build
  # The installer needs all configured modules; a silently skipped optional
  # dependency must fail packaging rather than produce an unusable ISO.
  for module in welcome keyboard locale partition users summary finishedq; do
    test -s "$pkgdir/usr/lib/calamares/modules/$module/libcalamares_viewmodule_$module.so"
  done
  test -f "$pkgdir/usr/lib/calamares/modules/unpackfs/main.py"
}
